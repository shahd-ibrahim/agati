# Admin dashboard password (/admin)
ADMIN_PASSWORD=agati2026
# Secret used to sign the admin session cookie (any long random string)
ADMIN_SECRET=change-me-to-a-long-random-string
# Signs the table QR access tokens. Changing it invalidates every printed QR code.
QR_SECRET=change-me-to-another-long-random-string
# Demo mode: "/" opens the menu without a QR code. Set to false to re-enable the QR-only lock.
# (Table links /t/[id]?token=... are always verified.)
QR_DEMO_MODE=true
